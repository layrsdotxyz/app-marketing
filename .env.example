# Predifi Marketing Site — Environment Variables
# Copy to .env.local for development

# GetWaitlist widget ID
NEXT_PUBLIC_WAITLIST_ID=32647

# dApp URL (used for CTA links that point to the app)
NEXT_PUBLIC_APP_URL=https://app.predifi.com

# Site URL (used for canonical URLs and OG)
NEXT_PUBLIC_SITE_URL=https://predifi.com

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Resend — active email provider (bypasses SES sandbox)
RESEND_API_KEY=

# AWS SES — kept for when SES production access is granted
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@predifi.com